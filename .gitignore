# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# IDE
.idea/
.nova/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Enviroment
#application/config/cms.php
#application/config/database.php
#application/config/site.php
#application/config/smtp.php

# Ignore folder contents but keep the folders
application/cache/*
!application/cache/.gitkeep
application/logs/*
!application/logs/.gitkeep
application/sessions/*
!application/sessions/.gitkeep

# Ignore the multimedia folder and its content
# but keep the structure to avoid losing files on the server
multimedia/**/*
!multimedia/.gitkeep
