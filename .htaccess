RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/\.well-known/cpanel-dcv/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/(?:\ Ballot169)?
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/\.well-known/cpanel-dcv/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/(?:\ Ballot169)?
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteRule ^(.*)$ index.php/$1 [L]

Options -Indexes

RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)? [NC]
# RewriteRule \.(csv|doc|gif|jpg|jpeg|pdf|ppt|swf|txt|xls|mp3|mp4|mov|avi|aif|aiff|wav|tif|tiff|mpg|mpeg|m4a|aac|acc3|flac|zip)$ - [NC,F,L]
RewriteCond %{REQUEST_URI} !^/\.well-known/cpanel-dcv/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/(?:\ Ballot169)?
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteRule \.(csv|doc|gif|pdf|ppt|swf|txt|xls|mp3|mp4|mov|avi|aif|aiff|wav|tif|tiff|mpg|mpeg|m4a|aac|acc3|flac|zip)$ - [NC,F,L]

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php5_module>
   php_flag display_errors Off
   php_value max_execution_time 3600
   php_value max_input_time -1
   php_value max_input_vars 2000000
   php_value memory_limit 2048M
   php_value session.save_path "tmp"
   php_value upload_max_filesize 999999999M
   php_flag asp_tags Off
   php_value session.gc_maxlifetime 2880
   php_value post_max_size 999999999M
   php_flag zlib.output_compression Off
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors Off
   php_value max_execution_time 3600
   php_value max_input_time -1
   php_value max_input_vars 2000000
   php_value memory_limit 2048M
   php_value session.save_path "tmp"
   php_value upload_max_filesize 999999999M
   php_flag asp_tags Off
   php_value session.gc_maxlifetime 2880
   php_value post_max_size 999999999M
   php_flag zlib.output_compression Off
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php70” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php70 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
